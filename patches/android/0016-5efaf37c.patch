+    override fun resolveSystemPrompt(remotePrompt: String): String {
+        if (remotePrompt.isBlank()) return defaultSystemPrompt
+        // Remote Config is shared across apps; a prompt written for Asmaa must not leak into Maya.
+        val forAsmaa = remotePrompt.contains("asmaa", ignoreCase = true) ||
+            remotePrompt.any { it in '\u0600'..'\u06FF' }
+        return if (forAsmaa) defaultSystemPrompt else remotePrompt
+    }
 
