+
+// ==================== WhatsApp number sign-in ====================
+
+/** Phone first, then the 6-digit code sent on WhatsApp. Same look as the email screen. */
+@Composable
+fun WhatsAppSignInScreen(
+    state: WhatsAppState,
+    onPhoneChange: (String) -> Unit,
+    onSendCode: () -> Unit,
+    onCodeChange: (String) -> Unit,
+    onVerify: () -> Unit,
+    onResend: () -> Unit,
+    onChangeNumber: () -> Unit,
+    onBack: () -> Unit
+) {
+    // Back from the code step returns to the number; from the number it returns to the other sign-in options.
+    androidx.activity.compose.BackHandler {
+        if (state.step == WhatsAppStep.CODE) onChangeNumber() else onBack()
+    }
+    val screenWidth = LocalConfiguration.current.screenWidthDp
+    val horizontalPadding = if (screenWidth < 360) 16.dp else 24.dp
+    val titleSize = if (screenWidth < 360) 20.sp else 24.sp
+
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(Color(0xFFF6F6F8))
+            .systemBarsPadding()
+            .verticalScroll(rememberScrollState())
+            .padding(horizontal = horizontalPadding, vertical = 16.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.Center
+    ) {
+        Spacer(Modifier.weight(1f))
+        Text("💬", fontSize = if (screenWidth < 360) 36.sp else 48.sp)
+        Spacer(Modifier.height(12.dp))
+        Text(
+            if (state.step == WhatsAppStep.PHONE) "Continue with WhatsApp" else "Enter your code",
+            fontSize = titleSize, fontWeight = FontWeight.Bold
+        )
+        Text(
+            if (state.step == WhatsAppStep.PHONE) "We'll send a 6-digit code to your WhatsApp."
+            else "We sent a 6-digit code on WhatsApp to ${state.phone}.",
+            fontSize = 14.sp, color = Color(0xFF6B7280), textAlign = TextAlign.Center
+        )
+        Spacer(Modifier.height(24.dp))
+
+        if (state.step == WhatsAppStep.PHONE) {
+            OutlinedTextField(
+                value = state.phoneInput,
+                onValueChange = onPhoneChange,
+                label = { Text("WhatsApp number") },
+                supportingText = { Text("Without a country code it's +91. For another country start with + and the code.") },
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Phone),
+                enabled = !state.busy,
+                modifier = Modifier.fillMaxWidth(),
+                shape = RoundedCornerShape(12.dp),
+                singleLine = true
+            )
+        } else {
+            OutlinedTextField(
+                value = state.code,
+                onValueChange = onCodeChange,
+                label = { Text("6-digit code") },
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                enabled = !state.busy && !state.signedIn,
+                modifier = Modifier.fillMaxWidth(),
+                shape = RoundedCornerShape(12.dp),
+                singleLine = true
+            )
+        }
+
+        state.error?.let {
+            Text(it, color = Color.Red, fontSize = 12.sp, modifier = Modifier.padding(top = 4.dp))
+        }
+
+        Spacer(Modifier.height(16.dp))
+
+        Button(
+            onClick = if (state.step == WhatsAppStep.PHONE) onSendCode else onVerify,
+            enabled = if (state.step == WhatsAppStep.PHONE) !state.busy && state.phoneInput.isNotBlank() else state.canSubmitCode,
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(50.dp),
+            shape = RoundedCornerShape(12.dp),
+            colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF2563EB))
+        ) {
+            if (state.busy || state.signedIn) CircularProgressIndicator(modifier = Modifier.size(20.dp), color = Color.White)
+            else Text(if (state.step == WhatsAppStep.PHONE) "Send code" else "Verify")
+        }
+
+        if (state.step == WhatsAppStep.CODE) {
+            Spacer(Modifier.height(8.dp))
+            TextButton(onClick = onResend, enabled = state.canResend) {
+                Text(
+                    if (state.resendIn > 0) "Resend code in ${state.resendIn}s" else "Resend code",
+                    color = if (state.canResend) Color(0xFF2563EB) else Color(0xFF9CA3AF)
+                )
+            }
+            TextButton(onClick = onChangeNumber, enabled = !state.busy) {
+                Text("Use a different number", color = Color(0xFF2563EB))
+            }
+        } else {
+            Spacer(Modifier.height(8.dp))
+            TextButton(onClick = onBack, enabled = !state.busy) {
+                Text("Other sign-in options", color = Color(0xFF2563EB))
+            }
+        }
         Spacer(Modifier.weight(1f))
     }
 }
