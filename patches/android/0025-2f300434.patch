+/** Confirmation, password, progress and error dialogs for [DeleteAccountViewModel]. */
+@Composable
+fun DeleteAccountDialogs(
+    state: DeleteAccountViewModel.UiState,
+    onConfirm: () -> Unit,
+    onCancel: () -> Unit,
+    onSubmitPassword: (String) -> Unit
+) {
+    val danger = Color(0xFFEF4444)
+
+    if (state.confirming) {
+        AlertDialog(
+            onDismissRequest = onCancel,
+            title = { Text(stringResource(R.string.delete_account_title)) },
+            text = { Text(stringResource(R.string.delete_account_message)) },
+            confirmButton = {
+                TextButton(onClick = onConfirm) {
+                    Text(stringResource(R.string.delete_account_confirm), color = danger)
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = onCancel) {
+                    Text(stringResource(R.string.delete_account_cancel))
+                }
+            }
+        )
+    }
+
+    if (state.needsPassword) {
+        var password by remember { mutableStateOf("") }
+        AlertDialog(
+            onDismissRequest = onCancel,
+            title = { Text(stringResource(R.string.delete_account_password_title)) },
+            text = {
+                Column {
+                    Text(stringResource(R.string.delete_account_password_message))
+                    Spacer(Modifier.height(12.dp))
+                    OutlinedTextField(
+                        value = password,
+                        onValueChange = { password = it },
+                        label = { Text(stringResource(R.string.delete_account_password_hint)) },
+                        singleLine = true,
+                        visualTransformation = androidx.compose.ui.text.input.PasswordVisualTransformation()
+                    )
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = { onSubmitPassword(password) }, enabled = password.isNotEmpty()) {
+                    Text(stringResource(R.string.delete_account_password_submit))
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = onCancel) {
+                    Text(stringResource(R.string.delete_account_cancel))
+                }
+            }
+        )
+    }
+
+    if (state.inProgress && !state.needsPassword) {
+        AlertDialog(
+            onDismissRequest = {},
+            confirmButton = {},
+            text = {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    CircularProgressIndicator(modifier = Modifier.size(24.dp))
+                    Spacer(Modifier.width(16.dp))
+                    Text(stringResource(R.string.delete_account_in_progress))
+                }
+            }
+        )
+    }
+
+    state.failedStep?.let { step ->
+        val message = if (step == org.ekatra.alfred.data.account.AccountDeleter.Step.REAUTHENTICATION) {
+            R.string.delete_account_failed_reauth
+        } else {
+            R.string.delete_account_failed
+        }
+        AlertDialog(
+            onDismissRequest = onCancel,
+            text = { Text(stringResource(message)) },
+            confirmButton = {
+                TextButton(onClick = onConfirm) {
+                    Text(stringResource(R.string.delete_account_retry))
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = onCancel) {
+                    Text(stringResource(R.string.delete_account_cancel))
+                }
+            }
+        )
+    }
+}
