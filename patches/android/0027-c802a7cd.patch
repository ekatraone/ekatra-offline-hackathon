+     * Removes every cached setting except [KEY_CONSENT_SHOWN], so a user who deleted their
+     * account is not shown the consent screen again on the same device. The analytics and
+     * feedback choices are cleared too, so collection stays off until they choose again.
+     */
+    fun clearAllExceptConsent() {
+        val editor = prefs.edit()
+        prefs.all.keys.filter { it != KEY_CONSENT_SHOWN }.forEach { editor.remove(it) }
+        editor.apply()
+    }
