+                    try { awaitCancellation() } finally { if (!finished.get()) nativeCancel() }
+                }
+                try {
+                    nativePrepare(fullPrompt)
+                } finally {
+                    finished.set(true)
+                    abortWatcher.cancel()
+                }
+            }
