diff --git a/app/src/main/java/org/ekatra/alfred/data/sync/SyncWorker.kt b/app/src/main/java/org/ekatra/alfred/data/sync/SyncWorker.kt
index 27b28b2..065f5dd 100644
--- a/app/src/main/java/org/ekatra/alfred/data/sync/SyncWorker.kt
+++ b/app/src/main/java/org/ekatra/alfred/data/sync/SyncWorker.kt
@@ -27,16 +27,27 @@ class SyncWorker @AssistedInject constructor(
         const val WORK_NAME = "ekatra_sync"
         const val LEARNER_WORK_NAME = "learner_sync"
 
+        /** Short linear backoff: a cold-start failure retries after 10 s, 20 s, ... not minutes. */
+        const val LEARNER_BACKOFF_SECONDS = 10L
+
+        internal fun learnerSyncRequest(): OneTimeWorkRequest =
+            OneTimeWorkRequestBuilder<SyncWorker>()
+                .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build())
+                .setBackoffCriteria(BackoffPolicy.LINEAR, LEARNER_BACKOFF_SECONDS, TimeUnit.SECONDS)
+                .build()
+
+        internal fun learnerSyncPolicy(replace: Boolean): ExistingWorkPolicy =
+            if (replace) ExistingWorkPolicy.REPLACE else ExistingWorkPolicy.KEEP
+
         /**
          * Queue a learner sync (lesson requests + quiz events) to run once there is a network.
-         * KEEP: if one is already queued or running, it will pick up the new rows.
+         * Normal triggers use KEEP: a queued run will pick up the new rows. On reconnect pass
+         * [replace] = true, so a run that is sitting in retry backoff is replaced by a fresh one
+         * and "Synced" shows within seconds of the network coming back.
          */
-        fun enqueueLearnerSync(context: Context) {
-            val request = OneTimeWorkRequestBuilder<SyncWorker>()
-                .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build())
-                .build()
+        fun enqueueLearnerSync(context: Context, replace: Boolean = false) {
             WorkManager.getInstance(context).enqueueUniqueWork(
-                LEARNER_WORK_NAME, ExistingWorkPolicy.KEEP, request
+                LEARNER_WORK_NAME, learnerSyncPolicy(replace), learnerSyncRequest()
             )
         }
 
