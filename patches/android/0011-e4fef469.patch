diff --git a/app/src/main/cpp/llama_jni.cpp b/app/src/main/cpp/llama_jni.cpp
index deaa4a7..2b25d4d 100644
--- a/app/src/main/cpp/llama_jni.cpp
+++ b/app/src/main/cpp/llama_jni.cpp
@@ -197,10 +197,13 @@ Java_org_ekatra_alfred_LlamaEngine_nativeLoadModel(
     // Create sampler chain
     auto sparams = llama_sampler_chain_default_params();
     g_sampler = llama_sampler_chain_init(sparams);
+    // Mild repeat penalty over the last 64 tokens: 1B-class models otherwise loop on a
+    // phrase until the 512-token cap. Random seed so a retried question can differ.
+    llama_sampler_chain_add(g_sampler, llama_sampler_init_penalties(64, 1.1f, 0.0f, 0.0f));
     llama_sampler_chain_add(g_sampler, llama_sampler_init_temp(0.7f));
     llama_sampler_chain_add(g_sampler, llama_sampler_init_top_k(40));
     llama_sampler_chain_add(g_sampler, llama_sampler_init_top_p(0.9f, 1));
-    llama_sampler_chain_add(g_sampler, llama_sampler_init_dist(42));
+    llama_sampler_chain_add(g_sampler, llama_sampler_init_dist(LLAMA_DEFAULT_SEED));
     
     LOGI("Model loaded! Vocab: %d, Ctx: %d", 
          llama_vocab_n_tokens(llama_model_get_vocab(g_model)), llama_n_ctx(g_ctx));
@@ -227,6 +230,7 @@ Java_org_ekatra_alfred_LlamaEngine_nativePrepare(
     // Appending to the previous turn's cache duplicated history and overflowed n_ctx.
     llama_memory_clear(llama_get_memory(g_ctx), true);
     reset_generation_state();
+    if (g_sampler) llama_sampler_reset(g_sampler); // penalty history is per reply
 
     // Tokenize prompt
     auto tokens = tokenize(g_model, prompt, true);
