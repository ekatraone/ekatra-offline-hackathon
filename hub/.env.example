# Environment Variables for Ekatra AI Offline Learning System
HF_TOKEN=your_huggingface_token_here
TUNE_API_KEY=your_tune_api_key_here
TUNE_ORG_ID=your_tune_org_id_here

# WiFi Configuration
WIFI_SSID=EkatraHub
WIFI_PASSWORD=your_wifi_password_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
USE_LOCAL_MODEL=true

# Model Configuration
MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct
MAX_TOKENS=200
TEMPERATURE=0.7
