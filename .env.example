# Copy to the backend checkout as .env (after running scripts/apply_overlay.sh) and fill in.
# Variable names only; never commit real values.

# --- Meta Model API (Muse Wonder text, Muse Image pictures) ---
MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL_ID=
META_IMAGE_MODEL_ID=

# --- Core ---
DATABASE_URL=
JWT_SECRET=
PUBLIC_BASE_URL=
PORT=
NODE_ENV=
TRUST_PROXY_HOPS=

# --- Offline app (Maya) sync and sign-in ---
DEMO_INVITE_CODE=
ALLOW_TESTER_JOIN=
FIREBASE_SERVICE_ACCOUNT=
OTP_HMAC_SECRET=
OTP_DAILY_CAP=

# --- WhatsApp one-time codes and delivery through Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_OTP_CONTENT_SID=
TWILIO_WHATSAPP_NUMBER=

# --- Generation options ---
COURSE_SIZE=
COURSE_IMAGES=
DISABLE_FEEDBACK_FLOW=
WEBHOOK_BASE_URL=
WEBHOOK_RECOVERY_INTERVAL_MS=

# --- Demo-script guards ---
ALLOW_DEMO_DB=
